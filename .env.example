# --- Obrigatório para o motor de interpretação ---
# É a única parte do produto que consome IA: uma chamada por captura.
ANTHROPIC_API_KEY=

# --- Persistência (opcional no dev) ---
# Sem estas duas, o NEXO usa um store em memória que some no restart.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Entrega dos avisos (opcional) ---
# Sem webhook, os avisos saem no log do servidor. Com webhook, cada aviso vira
# um POST JSON — plugue WhatsApp, Telegram, e-mail transacional ou n8n.
NEXO_NOTIFY_WEBHOOK=

# Protege /api/cron/dispatch. Na Vercel, o cron manda este valor sozinho.
CRON_SECRET=
