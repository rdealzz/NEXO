# ============================================================ obrigatório
# A única parte do produto que consome IA: uma chamada por captura.
ANTHROPIC_API_KEY=

# ============================================================ persistência
# Sem estas, o NEXO usa um store em memória que some no restart.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# URL pública do app — usada nos links de login e nas respostas do WhatsApp.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ============================================================ avisos
# Sem webhook, os avisos saem no log do servidor. Com webhook, cada aviso vira
# um POST JSON — plugue WhatsApp, Telegram, push ou e-mail transacional.
NEXO_NOTIFY_WEBHOOK=

# Protege /api/cron/dispatch. Na Vercel, o cron manda este valor sozinho.
CRON_SECRET=

# ============================================================ entrada externa
# E-mail encaminhado chega em <slug>@INBOUND_EMAIL_DOMAIN.
INBOUND_EMAIL_DOMAIN=
# Segredo que o provedor de inbound parse manda no header x-nexo-secret.
INBOUND_SECRET=

# WhatsApp Cloud API (Meta).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# ============================================================ transcrição
# Áudio do WhatsApp não passa pelo navegador, então precisa ser transcrito no
# servidor. Endpoint compatível com a API da OpenAI (a própria, ou Groq).
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_API_BASE=https://api.openai.com/v1
TRANSCRIPTION_MODEL=whisper-1

# E-mail de contato mostrado nos documentos legais. Opcional: sem ele, as
# páginas apontam o contato dentro do app em vez de mostrar um endereço.
NEXT_PUBLIC_EMAIL_CONTATO=

# --- Avisos push (Web Push) --------------------------------------------------
# Gere o par uma vez com `npm run chaves:push` e guarde. A chave pública também
# vai para o navegador, por isso aparece duas vezes. Sem elas, o NEXO cai no
# webhook de NEXO_NOTIFY_WEBHOOK.
VAPID_PUBLIC_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Como o serviço de push fala com você se algo der errado (mailto: ou https:).
VAPID_SUBJECT=

# --- Assinatura (Asaas) ------------------------------------------------------
# Chave da API do Asaas. Sandbox: https://sandbox.asaas.com/api/v3
ASAAS_API_KEY=
ASAAS_API_URL=https://api.asaas.com/v3
# Token combinado no painel do Asaas ao cadastrar o webhook. Sem ele, qualquer
# um na internet liberaria a própria conta com um POST.
ASAAS_WEBHOOK_TOKEN=
