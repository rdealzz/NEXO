# ============================================================ obrigatório
# A única parte do produto que consome IA: uma chamada por captura.
ANTHROPIC_API_KEY=

# ============================================================ persistência
# Sem estas, o NEXO usa um store em memória que some no restart.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# URL pública do app — usada nos links de login e nas respostas do WhatsApp.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ============================================================ avisos
# Sem webhook, os avisos saem no log do servidor. Com webhook, cada aviso vira
# um POST JSON — plugue WhatsApp, Telegram, push ou e-mail transacional.
NEXO_NOTIFY_WEBHOOK=

# Protege /api/cron/dispatch. Na Vercel, o cron manda este valor sozinho.
CRON_SECRET=

# ============================================================ entrada externa
# E-mail encaminhado chega em <slug>@INBOUND_EMAIL_DOMAIN.
INBOUND_EMAIL_DOMAIN=
# Segredo que o provedor de inbound parse manda no header x-nexo-secret.
INBOUND_SECRET=

# WhatsApp Cloud API (Meta).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# ============================================================ transcrição
# Áudio do WhatsApp não passa pelo navegador, então precisa ser transcrito no
# servidor. Endpoint compatível com a API da OpenAI (a própria, ou Groq).
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_API_BASE=https://api.openai.com/v1
TRANSCRIPTION_MODEL=whisper-1

# --- Identificação legal (obrigatória antes de publicar nas lojas) -----------
# Aparecem nos Termos de Uso e na Política de Privacidade. Sem elas, as páginas
# omitem a linha em vez de inventar um dado.
NEXT_PUBLIC_EMPRESA_NOME=
NEXT_PUBLIC_EMPRESA_CNPJ=
NEXT_PUBLIC_EMPRESA_ENDERECO=
NEXT_PUBLIC_EMAIL_CONTATO=
